{
  "workspace": {
    "type": "repo",
    "repo": "https://github.com/gemini-cli-extensions/workspace",
    "entry": "workspace-server/dist/index.js",
    "build": "npm install && npm run build",
    "description": "Gmail, Calendar, Drive, Docs, Sheets, Chat"
  },
  "granola": {
    "type": "remote",
    "url": "https://mcp.granola.ai/mcp",
    "description": "Meeting notes and transcripts"
  },
  "github": {
    "type": "remote",
    "url": "https://api.githubcopilot.com/mcp/",
    "auth": "gh auth token",
    "description": "Repos, issues, PRs, commits"
  },
  "apify": {
    "type": "remote",
    "url": "https://mcp.apify.com",
    "description": "Apify Actors, web scraping, automation, docs",
    "authoringDiscovery": "src/mcp/discover/apify.ts",
    "meta": {
      "docs": "https://docs.apify.com/platform/integrations/mcp",
      "provider": "Apify"
    }
  },
  "composio": {
    "type": "remote",
    "url": "https://connect.composio.dev/mcp",
    "description": "Telegram, Slack, and 250+ integrations",
    "proxy": {
      "via": "COMPOSIO_MULTI_EXECUTE_TOOL",
      "connectDiscovery": "src/mcp/discover/composio.ts",
      "dashboardUrl": "https://dashboard.composio.dev/"
    },
    "meta": {
      "pricing": "Free 20K calls/mo, $29/mo after",
      "docs": "https://docs.composio.dev",
      "provider": "Composio"
    }
  }
}
